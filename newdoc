#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'

load File.expand_path('document_types', __dir__)

# Create scaffolding for LaTeX documents that use autodoc, docbld, and
# tlc-article.
class NewDoc
  attr_reader :argv, :cwd

  def initialize(argv)
    @argv = argv
    @cwd = Dir.pwd
    @dir_flag = false
    @file_flag = false
    @help_flag = argv.empty?
    @logo_flag = false
    @share_flag = false
    @tof_flag = false
    @title_flag = false
    @doc_type = ''
  end

  def run
    parse_options
    return show_help if @help_flag

    make_doc
  end

  private

  def parse_options
    argv.each do |argument|
      case argument
      when /\A--dir=/
        @dir = argument.delete_prefix('--dir=')
        @dir_flag = true
      when /\A--file=/
        @file_name = argument.delete_prefix('--file=')
        @file_flag = true
      when '--help'
        @help_flag = true
      when '--logo'
        @logo_flag = true
      when /\A--title=/
        @title = argument.delete_prefix('--title=')
        @title_flag = true
      when '--tof'
        @tof_flag = true
      when /\A--type=/
        check_doc_type(argument.delete_prefix('--type='))
      when '--shared'
        @share_flag = true
      else
        puts "Unknown argument #{argument}"
        puts
        @help_flag = true
      end
    end
  end

  def show_help
    puts 'Run newdoc to create the scaffolding for a new LaTeX document'
    puts 'that is compatible with autodoc, docbld, and tlc-article.'
    puts
    puts 'Usage: newdoc --dir=path/to/dir [other options]'
    puts
    puts 'OPTIONS'
    puts '  --dir=path/to/dir              Directory to create.'
    puts '  --file=fileName                File to create.'
    puts "  --title='Your Document Title'  Document title to use."
    puts
    puts "  --type=(one of:) #{DOCUMENT_TYPES.join(' ')}"
    puts
    puts '  --logo                         Seed document with a logo.'
    puts '  --shared                       Use shared header and footer data.'
    puts
    puts '  --tof                          Hook into Test Output Factory.'
    puts
    puts '  --help                         Display this help message.'
    puts
    check_for_newdoc_path
  end

  def make_doc
    check_for_newdoc_path
    check_for_valid_flags

    Dir.chdir(newdoc_path) do
      create_doc_dir
      create_data_dir
      create_shared_data_dir
      create_tof_dir
      set_document_number
      copy_tex_file
      copy_texx_builder_file
      copy_change_summary
      copy_signatures
      copy_version
      copy_additional_layout
      copy_header_footer
      copy_logo
      copy_tof
    end
  end

  def check_doc_type(candidate)
    return @doc_type = candidate if DOCUMENT_TYPES.include?(candidate)

    puts "Document type #{candidate} is not supported."
    puts "Use one of #{DOCUMENT_TYPES.join(' ')}"
    exit 1
  end

  def check_for_newdoc_path
    fail!('NEWDOCPATH must be defined.') unless newdoc_path && Dir.exist?(newdoc_path)
  end

  def check_for_valid_flags
    fail!('--dir option must be used.') unless @dir_flag
    fail!('--file option must be used when --title is used.') if @title_flag && !@file_flag
  end

  def create_doc_dir
    return unless @dir_flag

    @sub_dir = File.join(cwd, @dir)
    msg("Creating document directory #{@sub_dir}")
    FileUtils.mkdir_p(@sub_dir, verbose: true)
  end

  def create_data_dir
    return unless @dir_flag

    @data_dir = File.join(@sub_dir, 'data')
    msg("Creating document data directory #{@data_dir}")
    FileUtils.mkdir_p(@data_dir, verbose: true)
  end

  def create_shared_data_dir
    return unless @share_flag

    @shared_data_dir = File.join(File.dirname(@sub_dir), 'shared', 'data')
    msg("Creating project shared data directory #{@shared_data_dir}")
    FileUtils.mkdir_p(@shared_data_dir, verbose: true)
  end

  def create_tof_dir
    return unless @tof_flag

    @tof_dir = File.join(@sub_dir, 'test-output')
    msg("Creating Test Output Factory #{@tof_dir}")
    FileUtils.mkdir_p(@tof_dir, verbose: true)
  end

  def set_document_number
    @doc_nbr = @file_name.to_s.upcase
  end

  def copy_tex_file
    return unless @file_flag

    destination = File.join(@sub_dir, "#{@file_name}.tex")
    msg("Copying primary LaTeX file #{destination}")
    write_template('data/nnnnnn.txt', destination,
                   '%docType' => @doc_type,
                   '%docTitle' => @title.to_s,
                   '%\input' => '\input')
  end

  def copy_texx_builder_file
    return unless @file_flag

    destination = File.join(@sub_dir, "#{@file_name}.texx")
    msg("Copying docbld file #{destination}")
    write_template('data/nnnnnn.txtt', destination, '%docNbr' => @file_name)
  end

  def copy_change_summary
    return unless @file_flag

    destination = File.join(@sub_dir, 'change-summary.tex')
    msg("Copying change summary file #{destination}")
    copy_file('data/change-summary.tex', destination)
  end

  def copy_signatures
    return unless @file_flag

    destination = File.join(@sub_dir, 'signatures.tex')
    msg("Copying signature file #{destination}")
    copy_file('data/signatures.tex', destination)
  end

  def copy_version
    return unless @file_flag

    destination = File.join(@data_dir, 'version.tex')
    msg("Copying version file #{destination}")
    write_template('data/version.txt', destination, '%docNbr' => @doc_nbr)
  end

  def copy_additional_layout
    return unless @file_flag

    destination = File.join(@data_dir, 'additional-layout.tex')
    msg("Copying additional layout file #{destination}")

    if @share_flag
      copy_file('data/additional-layout-shared.tex', destination)
      copy_shared_additional_layout
    else
      write_template('data/additional-layout.txt', destination, '%dataDir' => 'data')
    end
  end

  def copy_shared_additional_layout
    destination = File.join(@shared_data_dir, 'additional-layout.tex')
    return if File.exist?(destination)

    msg("Copying shared additional layout file #{destination}")
    write_template('data/additional-layout.txt', destination, '%dataDir' => '../shared/data')
  end

  def copy_header_footer
    return unless @file_flag

    destination = File.join(@data_dir, 'header-footer.tex')
    msg("Copying header footer file #{destination}")

    if @share_flag
      copy_file('data/header-footer-shared.tex', destination)
      copy_shared_header_footer
    else
      copy_file('data/header-footer.tex', destination)
    end
  end

  def copy_shared_header_footer
    destination = File.join(@shared_data_dir, 'header-footer.tex')
    return if File.exist?(destination)

    copy_file('data/header-footer.tex', destination)
  end

  def copy_logo
    return unless @logo_flag

    destination = File.join(@data_dir, 'logo.png')
    msg("Copying logo file #{destination}")
    copy_file('data/logo.png', destination)
  end

  def copy_tof
    return unless @tof_flag

    destination = File.join(@tof_dir, 'test-results.tex')
    msg("Copying Test Output Factory file #{destination}")
    copy_file('data/test-results.tex', destination)
  end

  def write_template(source, destination, substitutions)
    content = File.read(source)
    substitutions.each do |marker, replacement|
      content = content.gsub(marker, replacement)
    end
    File.write(destination, content)
  end

  def copy_file(source, destination)
    FileUtils.cp(source, destination, verbose: true)
  end

  def newdoc_path
    ENV.fetch('NEWDOCPATH', nil)
  end

  def fail!(message)
    msg("Aborting: #{message}")
    exit 1
  end

  def msg(message)
    puts
    puts message
  end
end

NewDoc.new(ARGV).run
